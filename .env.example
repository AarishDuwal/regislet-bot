# ── Discord Bot Token ──────────────────────────────────────────────
# Get this from https://discord.com/developers/applications
# Bot → Token → Reset Token (copy the full token)
DISCORD_TOKEN=your_bot_token_here

# ── Guild (Server) ID ──────────────────────────────────────────────
# Right-click your server icon → Copy Server ID (enable Developer Mode first)
# Used for instant slash command registration in your server.
# Remove this line to register commands globally (takes up to 1 hour).
GUILD_ID=your_server_id_here
